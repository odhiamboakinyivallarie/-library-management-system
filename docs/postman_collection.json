{
  "info": {
    "name": "Library Management System API",
    "description": "API collection for authentication, genres, books and borrowing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:3000"},
    {"key": "token", "value": ""},
    {"key": "userId", "value": ""},
    {"key": "genreId", "value": "cmwi7twbe0002v27g8d0vu43g"},
    {"key": "bookId", "value": ""},
    {"key": "borrowingId", "value": ""}
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Test Patron\",\"email\":\"newpatron@example.com\",\"password\":\"LibraryPass123!\"}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "if (pm.response.code === 201 || pm.response.code === 200) {",
                "  const data = pm.response.json();",
                "  pm.collectionVariables.set('token', data.accessToken);",
                "  pm.collectionVariables.set('userId', data.user.id);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"librarytest2026@test.com\",\"password\":\"LibraryPass123!\"}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create Genre",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Programming\",\"description\":\"Programming books\"}"
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Get All Genres",
          "request": {"method": "GET", "url": "{{baseUrl}}/genres"}
        },
        {
          "name": "Get One Genre",
          "request": {"method": "GET", "url": "{{baseUrl}}/genres/{{genreId}}"}
        },
        {
          "name": "Update Genre",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"description\":\"Updated description\"}"},
            "url": "{{baseUrl}}/genres/{{genreId}}"
          }
        },
        {
          "name": "Delete Genre",
          "request": {"method": "DELETE", "url": "{{baseUrl}}/genres/{{genreId}}"}
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get All Books (Filtering and Pagination)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?genreId={{genreId}}&search=&page=1&limit=10"
          }
        },
        {
          "name": "Get One Book",
          "request": {"method": "GET", "url": "{{baseUrl}}/books/{{bookId}}"}
        },
        {
          "name": "Create Book (Librarian)",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Learning TypeScript\",\"author\":\"John Smith\",\"isbn\":\"9781234567899\",\"totalCopies\":5,\"genreId\":\"{{genreId}}\"}"
            },
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Update Book (Librarian)",
          "request": {
            "method": "PATCH",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Authorization", "value": "Bearer {{token}}"}
            ],
            "body": {"mode": "raw", "raw": "{\"description\":\"Updated book description\"}"},
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Delete Book (Librarian)",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        }
      ]
    },
    {
      "name": "Borrowing",
      "item": [
        {
          "name": "Borrow a Book",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"userId\":\"{{userId}}\",\"bookId\":\"{{bookId}}\",\"dueDate\":\"2026-12-01T00:00:00.000Z\"}"
            },
            "url": "{{baseUrl}}/borrowing"
          }
        },
        {
          "name": "Return a Book",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/borrowing/{{borrowingId}}/return"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{"key": "token", "value": "{{token}}", "type": "string"}]
  }
}
